<?xml version="1.0" encoding="utf-8" ?>
<Defs>

	<HediffDef>
		<defName>SystemicIntoxication</defName>
		<hediffClass>HediffWithComps</hediffClass>
		<defaultLabelColor>(0.3, 1, 0.3)</defaultLabelColor>
		<label>Systemical Intoxication</label>
		<description>The flood of product of organ's necrosis gushing into the blood. Can't be treated directly, to save pawn's life the source of the toxin products must be removed.</description>
		<scenarioCanAdd>true</scenarioCanAdd>
		<initialSeverity>0.05</initialSeverity>
		<maxSeverity>1.05</maxSeverity>
		<duplicationAllowed>false</duplicationAllowed>
		  <comps>
			<li Class="HediffCompProperties_SeverityPerDay">
				<severityPerDay>-0.1</severityPerDay>
			</li>
		</comps>
		<stages>
			<li>
				<label>Minor</label>
				<minSeverity>0</minSeverity>
				<restFallFactor>3</restFallFactor>
				<hungerRateFactorOffset>0.9</hungerRateFactorOffset>
				<painOffset>0.3</painOffset>
				<becomeVisible>true</becomeVisible>
				<capMods>
					<li>
						<capacity>Consciousness</capacity>
						<postFactor>0.90</postFactor>
					</li>
					<li>
						<capacity>BloodFiltration</capacity>
						<postFactor>0.7</postFactor>
					</li>
				</capMods>
			</li>
			<li>
				<label>Moderate</label>
				<minSeverity>0.4</minSeverity>
				<restFallFactor>5</restFallFactor>
				<hungerRateFactorOffset>0.8</hungerRateFactorOffset>
				<painOffset>0.4</painOffset>
				<becomeVisible>true</becomeVisible>
				<capMods>
					<li>
						<capacity>Consciousness</capacity>
						<postFactor>0.7</postFactor>
					</li>
					<li>
						<capacity>BloodFiltration</capacity>
						<postFactor>0.6</postFactor>
					</li>
				</capMods>
			</li>
			<li>
				<label>Major</label>
				<minSeverity>0.7</minSeverity>
				<restFallFactor>10</restFallFactor>
				<hungerRateFactorOffset>0.6</hungerRateFactorOffset>
				<painOffset>0.2</painOffset>
				<becomeVisible>true</becomeVisible>
				<capMods>
					<li>
						<capacity>Consciousness</capacity>
						<postFactor>0.5</postFactor>
					</li>
					<li>
						<capacity>BloodFiltration</capacity>
						<postFactor>0.3</postFactor>
					</li>
				</capMods>
			</li>
			<li>
				<label>Extreme</label>
				<minSeverity>0.9</minSeverity>
				<restFallFactor>10</restFallFactor>
				<hungerRateFactorOffset>0.5</hungerRateFactorOffset>
				<painOffset>0.1</painOffset>
				<becomeVisible>true</becomeVisible>
				<capMods>
					<li>
						<capacity>Consciousness</capacity>
						<postFactor>0.3</postFactor>
					</li>
					<li>
						<capacity>BloodFiltration</capacity>
						<postFactor>0.2</postFactor>
					</li>
				</capMods>
			</li>
			<li>
				<label>Fatal</label>
				<minSeverity>1</minSeverity>
				<restFallFactor>10</restFallFactor>
				<hungerRateFactorOffset>0.3</hungerRateFactorOffset>
				<becomeVisible>true</becomeVisible>
				<capMods>
					<li>
						<capacity>Consciousness</capacity>
						<postFactor>0.1</postFactor>
					</li>
					<li>
						<capacity>BloodFiltration</capacity>
						<postFactor>0</postFactor>
					</li>
				</capMods>
			</li>
		</stages>
	</HediffDef>
</Defs>